{
	"type": "structure",
	"script": [
		"if (start.structure ==. 'bettermineshafts:mineshaft_ice':",
		"int startY = start.minY",
		"int surfaceY = world_traits.`bigglobe:y_level_on_surface`(start.midX, start.midZ)",
		"unless (world_traits.`bigglobe:biome`(start.midX, surfaceY, start.midZ).isIn('#bigglobe:icy') &&",
				"startY.isBetween[",
					"world_traits.`bigglobe:cave_min_y`(start.midX, start.midZ),",
					"world_traits.`bigglobe:cave_max_y`(start.midX, start.midZ) - 32",
				")",
			":",		
				"return(false)",
			")",
		")",
		"return(true)"
	]
}